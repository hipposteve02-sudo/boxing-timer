{
  "name": "sling-ai-audit",
  "version": "1.0.0",
  "description": "Audit tool that scores Sling TV's readiness to be discovered, cited, and recommended by AI platforms (the \"retrieval economy\").",
  "type": "module",
  "bin": {
    "sling-ai-audit": "cli.js"
  },
  "scripts": {
    "audit": "node cli.js audit --target sling",
    "audit:mock": "node cli.js audit --target sling --mock --output both",
    "history": "node cli.js history --target sling"
  },
  "keywords": [
    "sling-tv",
    "ai-discoverability",
    "schema.org",
    "seo",
    "retrieval-economy",
    "audit"
  ],
  "author": "EchoStar / Sling TV Marketing",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  }
}
